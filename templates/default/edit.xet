<?xml version="1.0" encoding="UTF-8"?>
<?xml-model href="../../../doc/etemplate2/etemplate2.0.rng" type="application/xml" schematypens="http://relaxng.org/ns/structure/1.0"?>
<!DOCTYPE overlay PUBLIC "-//EGroupware GmbH//eTemplate 2.0//EN" "https://www.egroupware.org/etemplate2.0.dtd">
<overlay>
	<et2-template  id="bookmarks.edit.general" template="" lang="" group="0" version="1.9.001" layout="2-column" style="--label-width:9em; --column-min-width:100%">
		<et2-hbox  class="dialogHeader" hidden="@edit">
			<et2-description  value="URL" style="width:var(--label-width, 9em); margin-right:var(--sl-spacing-medium)"></et2-description>
			<et2-description  id="url" href="bookmarks.bookmarks_ui.redirect&amp;bm_id=$cont[id]" extraLinkTarget="_blank" style="flex:1"></et2-description>
			<et2-image  src="@favicon" class="favicon"></et2-image>
		</et2-hbox>
		<et2-hbox  class="dialogHeader" hidden="!@edit">
			<et2-textbox  label="URL" class="et2-label-fixed" style="flex:1" id="url" maxlength="255" required="1"></et2-textbox>
			<et2-image  src="@favicon" class="favicon"></et2-image>
		</et2-hbox>
		<et2-textbox  label="Name" id="name" maxlength="255" required="1"></et2-textbox>
		<et2-ai  span="all"><et2-textarea  label="Description" class="et2-label-fixed" id="desc"></et2-textarea></et2-ai>
		<et2-textbox  label="Keywords" id="keywords" maxlength="255"></et2-textbox>
		<et2-hbox>
			<et2-select-cat  label="Category" class="et2-label-fixed" style="flex:1" id="category"></et2-select-cat>
			<et2-button-icon  id="edit_category" image="edit"></et2-button-icon>
		</et2-hbox>
		<et2-select-number  label="Rating" id="rating" min="0" max="10"></et2-select-number>
		<et2-checkbox  label="Private" id="access" selectedValue="private" unselectedValue="public"></et2-checkbox>
	</et2-template>
	<et2-template  id="bookmarks.edit.details" template="" lang="" group="0" version="" layout="2-column" style="--label-width:9em; --column-min-width:100%">
		<et2-select-account  label="Owner" id="owner" readonly="true"></et2-select-account>
		<et2-date-time  label="Added" id="added" readonly="true"></et2-date-time>
		<et2-date-time  label="Updated" id="updated" readonly="true"></et2-date-time>
		<et2-date-time  label="Last visited" id="visited" readonly="true"></et2-date-time>
		<et2-textbox  label="Total visits" id="visits" readonly="true"></et2-textbox>
	</et2-template>
	<et2-template  id="bookmarks.edit.links" template="" lang="" group="0" version="">
		<grid width="100%">
			<columns>
				<column width="100"/>
				<column/>
			</columns>
			<rows>
				<row class="row" disabled="!@edit">
					<et2-link-to  id="link_to" span="all"></et2-link-to>
				</row>
				<row disabled="!@edit">
					<et2-link-add  id="link_to" span="all"></et2-link-add>
				</row>
				<row class="th">
					<et2-description  value="Existing links" span="all"></et2-description>
				</row>
				<row class="row_off" valign="top">
					<et2-link-list  id="link_to" span="all"></et2-link-list>
				</row>
			</rows>
		</grid>
	</et2-template>
	<et2-template  id="bookmarks.edit.history" template="" lang="" group="0" version="">
		<historylog id="history"/>
	</et2-template>
	<et2-template  id="bookmarks.edit" template="" lang="" group="0" version="1.9.001" layout="edit">
		<et2-tabbox  id="tabs" tabHeight="auto">
			<tabs>
				<tab id="general" label="General"/>
				<tab id="details" label="Details"/>
				<tab id="links" label="Links"/>
				<tab id="history" label="History"/>
			</tabs>
			<tabpanels>
				<et2-template  id="bookmarks.edit.general"></et2-template>
				<et2-template  id="bookmarks.edit.details"></et2-template>
				<et2-template  id="bookmarks.edit.links"></et2-template>
				<et2-template  id="bookmarks.edit.history"></et2-template>
			</tabpanels>
		</et2-tabbox>
		<et2-hbox  class="dialogFooterToolbar" style="min-width:0">
			<et2-button  label="Edit" id="edit"></et2-button>
			<et2-button  label="Save" id="save"></et2-button>
			<et2-button  label="Apply" id="apply"></et2-button>
			<et2-button  label="Cancel" id="cancel" onclick="window.close();"></et2-button>
			<et2-button  align="right" label="Delete" id="delete" onclick="Et2Dialog.confirm(widget,'Delete this entry','Delete')"></et2-button>
		</et2-hbox>
	</et2-template>
</overlay>
