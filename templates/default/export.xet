<?xml version="1.0" encoding="UTF-8"?>
<?xml-model href="../../../doc/etemplate2/etemplate2.0.rng" type="application/xml" schematypens="http://relaxng.org/ns/structure/1.0"?>
<!DOCTYPE overlay PUBLIC "-//EGroupware GmbH//eTemplate 2.0//EN" "https://www.egroupware.org/etemplate2.0.dtd">
<overlay>
	<et2-template  id="bookmarks.export" template="" lang="" group="0" version="1.7.001" layout="edit" style="--label-width:12em; --column-min-width:14em">
		<et2-description  value="%s bookmarks selected for export" id="bm_count" span="all" hidden="!@bm_count"></et2-description>
		<et2-description  value="Categories to export" class="dialogHeader" span="all" hidden="@bm_count"></et2-description>
		<et2-select-cat  label="Categories" id="category" multiple="true" span="all" style="margin-bottom:1.5em" helpText="(Selecting a category includes all sub-categories)"></et2-select-cat>
		<et2-select  label="Export format" id="format" span="all"></et2-select>
		<et2-hbox  class="dialogFooterToolbar">
			<et2-button  label="Export" id="export" onclick="widget.getInstanceManager().postSubmit();"></et2-button>
			<et2-button  label="Cancel" id="cancel" onclick="window.close();"></et2-button>
		</et2-hbox>
	</et2-template>
</overlay>
